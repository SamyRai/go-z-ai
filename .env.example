# Z.AI API Configuration
# Copy this file to .env and fill in your API key. The CLI loads .env from
# the current directory; client.NewClientFromEnv reads the same variables from
# the process environment (it does not load .env itself).

# Your Z.AI API Key (required)
ZAI_API_KEY=your_api_key_here

# Regional gateway (optional: global | china; aliases cn, bigmodel, west).
# Use "china" if your key was issued on open.bigmodel.cn. It selects every
# endpoint: chat, Anthropic, Responses, monitor (quota/usage), biz (account),
# and agents. Unset means global (api.z.ai).
# ZAI_REGION=global

# Chat/PaaS API root override (optional). Defaults to the region's root:
# https://api.z.ai/api/paas/v4 (global) or https://open.bigmodel.cn/api/paas/v4
# (china). Only the chat/PaaS services use it; set it for a proxy or for a
# GLM Coding Plan key's coding root (https://api.z.ai/api/coding/paas/v4).
# ZAI_API_BASE_URL=https://api.z.ai/api/paas/v4

# open.bigmodel.cn key for embeddings and moderations, which only that host
# serves (optional; falls back to ZAI_API_KEY).
# ZAI_CHINA_API_KEY=your_bigmodel_key_here

# Time zone the monitor (quota/usage) API reports in (optional; IANA name,
# "UTC", or an offset like "+8"). Default: UTC+8, the server's zone.
# ZAI_MONITOR_TIMEZONE=Asia/Shanghai

# --- Multiple accounts ---
# If you switch between more than one Z.AI account (e.g. pay-as-you-go and a
# GLM Coding Plan subscription), don't hand-edit the keys above — use the
# `accounts` command instead, which stores credentials in
# ~/.config/zai-client/accounts.json (override with ZAI_ACCOUNTS_FILE) and
# derives each account's endpoints from its detected type and region:
#
#   go-z-ai accounts add work --api-key <key>   # type and region auto-detected
#   go-z-ai accounts add cn --api-key <key> --region china
#   go-z-ai accounts use work                    # switch the active account
#   go-z-ai accounts list                        # see all accounts
#   go-z-ai accounts quota                       # quota and reset times for all accounts
#   go-z-ai accounts usage                       # token/tool usage heat map for all accounts
#
# Precedence: --api-key, then --account <name>, then ZAI_API_KEY, then the
# active account — so setting ZAI_API_KEY overrides the active account.
# ZAI_ACCOUNTS_FILE=/path/to/accounts.json

# --- Development: recording live-verification cassettes ---
# See pkg/client/live_verify_test.go. Recording calls the real API with your
# key (redacted from the saved cassette). `go test` doesn't read .env, so
# export the variables in your shell:
#   ZAI_RECORD=1 ZAI_API_KEY=... go test -run 'TestVerifyResponses$' ./pkg/client -v
# Some recordings need extra inputs: ZAI_AGENT_ID (agents), ZAI_VOICE_NAME,
# ZAI_VOICE_SAMPLE_FILE_ID, ZAI_VOICE_ID (voice clone/delete).
